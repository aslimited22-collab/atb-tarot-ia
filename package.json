{
  "name": "atb-tarot-ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "cross-env E2E_TEST=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:pending": "tsx scripts/check-pending-deliveries.ts",
    "test:ux60": "playwright test tests/e2e/limpeza-ux60.spec.ts",
    "test:redeliver": "vitest run tests/integration/redeliver.spec.ts",
    "test:check-pending": "vitest run tests/integration/check-pending.spec.ts",
    "test:site-url": "vitest run tests/integration/site-url.spec.ts",
    "verify:all": "npm run build && npx tsc --noEmit && npm run test:ux60 && npm run test:redeliver && npm run test:check-pending && npm run test:site-url"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "resend": "^6.12.2",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
