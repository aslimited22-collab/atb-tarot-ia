# --- Google Ads (conversões + remarketing) ---
# Todos são PÚBLICOS (aparecem no fonte do site). Setar em Production na Vercel.
# ID da conta (o código já tem default AW-11337182960, mas explicite aqui):
NEXT_PUBLIC_GADS_ID=AW-11337182960
# Rótulo da ação de conversão "Compra" (a parte depois da barra em AW-.../RÓTULO).
# Usado pelo SITE só no /obrigado-espirito (R$437, vendas intl/Stripe). O código
# tem default com o rótulo real, mas explicite aqui.
NEXT_PUBLIC_GADS_PURCHASE_LABEL=Vn61CImjkcccEPDd_p0q
# Rótulo da ação "Iniciar checkout" (dispara no clique do botão de compra). Preencha com o rótulo da sua ação de checkout.
NEXT_PUBLIC_GADS_CHECKOUT_LABEL=
# Rótulo da ação "Lead/Cadastro" (opcional — dispara no /cadastro).
NEXT_PUBLIC_GADS_LEAD_LABEL=
# OBS: as conversões de Compra dos produtos BR (Limpeza R$100, Pergunta R$29,
# Vídeo R$877) NÃO são disparadas pelo código — quem dispara é o PIXEL DO KIWIFY
# configurado em cada produto ("ao aprovar cartão/pix"). Disparar no site também
# contaria a venda 2x. Verificado no painel Kiwify: Compra Limpeza/Pergunta/Video.

# --- Google Ads: conversão SERVER-SIDE (redundância pro pixel Kiwify) ---
# Caminho durável: o webhook Kiwify tenta extrair o gclid do pedido e envia a
# conversão direto pra API do Google Ads — funciona mesmo se o pixel do Kiwify
# quebrar/for removido sem querer. SEM estas 6 envs, é 100% no-op (o pixel do
# Kiwify continua sendo a única fonte pros produtos BR). Ver src/lib/google-ads-conversions.ts
# pro passo a passo de como obter cada valor (setup manual no Google Cloud/Ads —
# NÃO é "só setar env": developer token, OAuth client, refresh token).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=6811637911
# ⚠️ NÃO é o rótulo "Vn61CImjkcccEPDd_p0q" do gtag — é o ID NUMÉRICO da ação
# "Compra" no Google Ads (Metas → Conversões → Compra → ID na URL).
GOOGLE_ADS_CONVERSION_ACTION_ID=

# --- GA4 (opcional — funil de conversão, hoje não existe nenhum analytics assim) ---
# Mesma lib gtag.js do Google Ads (custo zero). Sem a env, GA4 não é configurado.
NEXT_PUBLIC_GA4_ID=
